    "_postman_id": "dc9e660f-af0e-4faa-a70f-f03ee9a2d96f",
    "name": "LanchoneteAPI - Plano de Testes (12 cenários)",
    "description": "Plano de testes da LanchoneteAPI com 12 cenários: 6 positivos e 6 negativos. Abrange autenticação, autorização, validações, consulta de menu, pedidos, estoque e pagamento mock. Execute primeiro a pasta '00 - Preparação'. Os testes T04/T10 dependem de unidade e produto válidos; T12 depende da regra de recusa implementada no mock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Preparação",
      "description": "Preencha as credenciais no ambiente. Depois execute os três logins e, para os testes de pagamento, crie os pedidos auxiliares desta pasta.",
      "item": [
        {
          "name": "00.1 Login CLIENTE - salvar clienteToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Execute antes dos cenários que utilizam o perfil CLIENTE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{clienteUsuario}}\",\n  \"senha\": \"{{clienteSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login CLIENTE realizado com sucesso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const token = json?.data?.accessToken || json?.data?.access_token || json?.accessToken || json?.token;",
                  "pm.test(\"Token do CLIENTE foi retornado\", function () {",
                  "    pm.expect(token).to.exist;",
                  "});",
                  "if (token) pm.environment.set(\"clienteToken\", token);",
                  "pm.test(\"Tempo de resposta inferior a 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ]
        },
