            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": {{unidadeId}},\n  \"observacao\": \"Sem cebola - teste T04.\",\n  \"entrega\": false,\n  \"canalPedido\": \"APP\",\n  \"usarPontos\": false,\n  \"itempedido\": [\n    {\n      \"produtoId\": {{produtoId}},\n      \"quantidade\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
