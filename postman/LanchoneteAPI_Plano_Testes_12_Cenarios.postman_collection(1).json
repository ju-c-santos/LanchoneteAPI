    {
      "name": "01 - Plano de Testes (12 cenários)",
      "description": "6 testes positivos e 6 negativos.",
      "item": [
        {
          "name": "T01 [POSITIVO] Login com credenciais válidas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Valida autenticação com credenciais de um cliente cadastrado e ativo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{clienteUsuario}}\",\n  \"senha\": \"{{clienteSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"T01 - Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const token = json?.data?.accessToken || json?.data?.access_token || json?.accessToken || json?.token;",
                  "pm.test(\"T01 - Token JWT foi retornado\", function () {",
                  "    pm.expect(token).to.exist;",
                  "});",
                  "if (token) pm.environment.set(\"clienteToken\", token);",
                  "pm.test(\"Tempo de resposta inferior a 3000 ms\", function () {",
