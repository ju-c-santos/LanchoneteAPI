        {
          "name": "T02 [POSITIVO] Cadastrar novo cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuario/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "register"
              ]
            },
            "description": "Gera e-mail e CPF de teste antes de cada execução para reduzir conflito de unicidade.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Teste Postman\",\n  \"email\": \"{{novoEmail}}\",\n  \"cpf\": \"{{novoCpf}}\",\n  \"telefone\": \"(24)99999-9999\",\n  \"cep\": \"27500-000\",\n  \"senha\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now().toString();",
                  "pm.environment.set(\"novoEmail\", `cliente.postman.${ts}@email.com`);",
                  "pm.environment.set(\"novoCpf\", ts.slice(-11).padStart(11, \"1\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"T02 - Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"T02 - Resposta contém dados do usuário\", function () {",
                  "    pm.expect(json?.data).to.exist;",
                  "});",
                  "pm.test(\"Tempo de resposta inferior a 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ]
        },
